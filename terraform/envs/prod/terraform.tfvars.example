# Copy to terraform.tfvars (gitignored) and fill in.

project_name = "super-email"
aws_region   = "us-east-1"

data_bucket_name = "super-email-data" # must be globally unique

ses_domain      = "inbox.example.com" # a domain/subdomain you control
route53_zone_id = null                # set if that domain's zone is in this AWS account

ec2_instance_type   = "t3.micro"
ec2_ssh_public_key  = "ssh-ed25519 AAAA... you@yourhost" # contents of a public key file
ssh_allowed_cidr    = "1.2.3.4/32"                       # your IP, /32
webhook_subdomain   = "hooks"                            # inbound-webhook lives at hooks.<ses_domain>
root_volume_size_gb = 20
